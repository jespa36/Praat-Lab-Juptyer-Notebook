   "source": [
    "#Code for Vot duration of word-initial/p t k/\n",
    "data['Duration (ms)'] = pd.to_numeric(data['Duration (ms)'], errors='coerce')\n",
    "\n",
    "wordInitialVotPTK = data[(data['Measurement'] == \"VOT\") & (data['Position'] == 'word-initial') & (data['Phoneme'].isin(['/p/', '/t/', '/k/']))\n",
    "]\n",
    "\n",
    "meanVotPTK = wordInitialVotPTK.groupby('Phoneme')['Duration (ms)'].mean()\n",
    "print(meanVotPTK)\n",
    "\n",
