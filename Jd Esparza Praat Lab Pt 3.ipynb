    "# Add all necessary code for analysis and visualizations pertaining to your research question here.\n",
    "# Feel free to add more text and code blocks as you see fit!\n",
    "votData = data[data['Measurement'] == 'VOT'].copy()\n",
    "\n",
    "monolinguals = votData[\n",
    "    (votData['L1 English? (Yes/No)'] == 'Yes') &\n",
    "    (votData['Other languages? (Yes/No)'] == 'No')\n",
    "  ]\n",
    "\n",
    "spanishBilinguals = votData[\n",
    "  (votData['Other language 1'] == 'Spanish') |\n",
    "  (votData['Other language 2'] == 'Spanish') |\n",
    "  (votData['Other language 3'] == 'Spanish') |\n",
    "  (votData['Other language 4'] == 'Spanish')\n",
    "]\n",
    "\n",
    "print('   English Only Speakers: Place of Articulation Mean VOT   ')\n",
    "print(monolinguals.groupby('Articulation')['Duration (ms)'].mean())\n",
    "print(\"\\n\")\n",
    "\n",
    "print('   English-Spanish Speakers: Place of Articulation Mean VOT   ')\n",
    "print(spanishBilinguals.groupby('Articulation')['Duration (ms)'].mean())\n",
    "print(\"\\n\")\n",
    "\n",
    "\n",
    "meansMonolingual = monolinguals.groupby('Articulation')['Duration (ms)'].mean()\n",
    "\n",
    "meansBilingual = spanishBilinguals.groupby('Articulation')['Duration (ms)'].mean()\n",
    "\n",
    "meanDiff = (meansMonolingual - meansBilingual).abs()\n",
    "print(\"   Difference in Mean Voiced Onset Time (VOT)   \")\n",
    "print(meanDiff)\n",
    "print(\"\\n\")\n",
    "\n",
    "# Bar Chart figure for Research Question\n",
    "plt.figure(figsize=(10,6))\n",
    "\n",
    "sns.barplot(\n",
    "    data=votData,\n",
    "    x= 'Articulation',\n",
    "    y='Duration (ms)',\n",
    "    hue='L1 English? (Yes/No)',\n",
    "    errorbar=None,\n",
    "    palette= 'Set1'\n",
    ")\n",
    "plt.ylim(0, 60)\n",
    "plt.title('Place of Articulation Mean Voice Onset Time (VOT): English Monolinguals vs English-Spanish Bilinguals')\n",
    "plt.xlabel('Place of Articulation')\n",
    "plt.ylabel('Mean VOT Duration (ms)')\n",
    "plt.legend(labels=['Bilingual', 'Monolingual'],title='group')\n",
    "plt.show()"
